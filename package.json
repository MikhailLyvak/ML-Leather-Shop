{
  "name": "ml-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-fonts.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier \"**/*.{ts,cjs,js,jsx,tsx,mjs,json,md,css}\" --check --ignore-unknown --ignore-path .prettierignore",
    "format:write": "prettier \"**/*.{ts,cjs,js,jsx,tsx,mjs,json,md,css}\" --write --ignore-unknown --ignore-path .prettierignore",
    "check-types": "tsc --noEmit --pretty",
    "fonts:sync": "mkdir -p public/fonts/manrope && cp node_modules/@fontsource/manrope/files/manrope-cyrillic-400-normal.woff2 public/fonts/manrope/Manrope-Regular.woff2 && cp node_modules/@fontsource/manrope/files/manrope-cyrillic-500-normal.woff2 public/fonts/manrope/Manrope-Medium.woff2 && cp node_modules/@fontsource/manrope/files/manrope-latin-400-normal.woff2 public/fonts/manrope/Manrope-Regular-latin.woff2 && cp node_modules/@fontsource/manrope/files/manrope-latin-500-normal.woff2 public/fonts/manrope/Manrope-Medium-latin.woff2",
    "fonts:verify": "node scripts/verify-fonts.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
